<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Standard Android ADB USB interface (Class 255 / 0xFF, Subclass 66 / 0x42, Protocol 1 / 0x01) -->
    <usb-device class="255" subclass="66" protocol="1" />
    <!-- Fastboot interface (Class 255, Subclass 66, Protocol 3) -->
    <usb-device class="255" subclass="66" protocol="3" />
    <!-- Composite Android USB devices (class 0 = defined at interface level) -->
    <usb-device class="0" subclass="0" protocol="0" />
</resources>
